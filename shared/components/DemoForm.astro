---
import type { HTMLAttributes } from 'astro/types'
import Field from './Field.astro'
import Select from './Select.astro'
import Button from './Button.astro'
import t, { type Scenario, type ScenarioField } from '../i18n/translations/en/demo'
import { fieldId } from '../lib/demo-source'
interface Props extends HTMLAttributes<'form'> {
  item: Scenario
  /** Unique per preview so repeated scenarios on one page keep valid ids. */
  prefix: string
  labelledby: string
}
// The live counterpart of demo-source.ts#htmlFor: the same names, ids (with a
// prefix), helper and error slots, rendered with the site's shared controls.
const { item, prefix, labelledby, class: className, ...attributes } = Astro.props
const describedBy = (id: string, field: ScenarioField) =>
  [field.help ? `${id}-help` : '', field.errors === false ? '' : `${id}-error`]
    .filter(Boolean)
    .join(' ') || undefined
// Scenarios with steps render one fieldset per step; later steps start hidden.
const groups = item.steps
  ? item.steps.map((legend, step) => ({
      legend,
      step,
      fields: item.fields.filter(field => field.step === step),
    }))
  : [{ legend: undefined, step: undefined, fields: item.fields }]
const entries = groups.map(group => ({
  ...group,
  Tag: (group.legend === undefined ? 'div' : 'fieldset') as 'div' | 'fieldset',
  fields: group.fields.map(field => ({ field, id: fieldId(item, field, prefix) })),
}))
---

<form
  {...attributes}
  class:list={['demo-form', className]}
  novalidate
  data-errors={item.errorStyle}
  data-variant={item.variant}
  aria-labelledby={labelledby}
  data-demo-form
>
  {entries.map(({ Tag, ...group }) => (
    <Tag
      class:list={[group.legend === undefined ? 'plain' : 'step']}
      data-step={group.step}
      hidden={(group.step ?? 0) > 0}
    >
      {group.legend !== undefined && <legend>{group.legend}</legend>}
      {group.fields.map(({ field, id }) =>
        field.type === 'checkboxes' || field.type === 'radios' ? (
          <fieldset class:list={['choices']} aria-describedby={describedBy(id, field)}>
            <legend>{field.label}</legend>
            <div class:list={['choice-list']}>
              {field.options!.map(([value, label]) => (
                <label class:list={['choice']}>
                  <input
                    type={field.type === 'radios' ? 'radio' : 'checkbox'}
                    name={field.name}
                    value={value}
                    checked={value === field.value}
                  />
                  <span>{label}</span>
                </label>
              ))}
            </div>
            {field.errors !== false && (
              <p
                class:list={['error']}
                id={`${id}-error`}
                data-error-for={field.name}
                aria-live="polite"
              />
            )}
          </fieldset>
        ) : field.type === 'checkbox' ? (
          <div class:list={['form-field']}>
            <label class:list={['choice', 'consent']}>
              <input
                type="checkbox"
                id={id}
                name={field.name}
                value={field.options![0]![0]}
                aria-describedby={describedBy(id, field)}
              />
              <span>{field.options![0]![1]}</span>
            </label>
            {field.errors !== false && (
              <p
                class:list={['error']}
                id={`${id}-error`}
                data-error-for={field.name}
                aria-live="polite"
              />
            )}
          </div>
        ) : field.type === 'repeated' ? (
          <div class:list={['guests']} data-guests>
            <div class:list={['guest']} data-guest>
              <label for="guest-1">{field.label}</label>
              <div class:list={['guest-row']}>
                <input id="guest-1" name={field.name} autocomplete={field.autocomplete} />
                <Button variant="secondary" data-remove>
                  {t.removeGuest}
                </Button>
              </div>
            </div>
          </div>
        ) : (
          <div class:list={['form-field']}>
            {field.type === 'select' ? (
              <Select
                id={id}
                name={field.name}
                label={field.label}
                options={field.options!}
                aria-describedby={describedBy(id, field)}
              />
            ) : field.type === 'multiselect' ? (
              <div class:list={['textarea']}>
                <label for={id}>{field.label}</label>
                <select
                  id={id}
                  name={field.name}
                  multiple
                  size={field.options!.length}
                  aria-describedby={describedBy(id, field)}
                >
                  {field.options!.map(([value, label]) => (
                    <option value={value}>{label}</option>
                  ))}
                </select>
              </div>
            ) : field.type === 'textarea' ? (
              <div class:list={['textarea']}>
                <label for={id}>{field.label}</label>
                <textarea
                  id={id}
                  name={field.name}
                  rows="4"
                  placeholder={field.placeholder}
                  aria-describedby={describedBy(id, field)}
                />
              </div>
            ) : (
              <Field
                id={id}
                name={field.name}
                type={field.type}
                label={field.label}
                value={field.value}
                placeholder={field.placeholder}
                autocomplete={field.autocomplete}
                inputmode={field.inputmode}
                spellcheck="false"
                aria-describedby={describedBy(id, field)}
              />
            )}
            {field.help && (
              <p class:list={['help']} id={`${id}-help`}>
                {field.help}
              </p>
            )}
            {field.errors !== false && (
              <p
                class:list={['error']}
                id={`${id}-error`}
                data-error-for={field.name}
                aria-live="polite"
              />
            )}
          </div>
        )
      )}
    </Tag>
  ))}
  <div class:list={['actions']}>
    {(item.actions ?? []).map(action => (
      <Button variant="secondary" {...{ [action.hook]: '' }}>
        {action.label}
      </Button>
    ))}
    <Button type="submit">{item.submit}</Button>
  </div>
</form>

<style>
  .demo-form {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  /* Behavior regions toggle steps and buttons with the hidden attribute. */
  .demo-form :global([hidden]) {
    display: none !important;
  }
  .plain,
  .step {
    display: grid;
    gap: 1rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .plain {
    display: contents;
  }
  .step > legend {
    margin-bottom: 0.25rem;
    font: 0.65rem/1.6 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .form-field,
  .guest {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  .help,
  .error {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .error {
    color: var(--color-danger);
    font-weight: 500;
  }
  .error:empty {
    display: none;
  }
  /* The package marks invalid controls with css-error and aria-invalid. */
  .demo-form :global([css-error]) {
    border-color: var(--color-danger);
  }
  .demo-form[data-errors='filled'] :global([css-error]:not([css-filled])) {
    border-color: var(--color-border);
  }
  .demo-form :global(.error-summary) {
    display: grid;
    gap: 0.375rem;
    padding: 0.875rem 1rem;
    border: 0.0625rem solid var(--color-danger);
    border-radius: var(--radius-control);
    color: var(--color-danger);
    font-size: 0.875rem;
  }
  .demo-form :global(.error-summary p),
  .demo-form :global(.error-summary ul) {
    margin: 0;
  }
  .demo-form :global(.error-summary ul) {
    padding-left: 1.25rem;
  }
  .demo-form :global(.error-summary a) {
    color: inherit;
    text-decoration: underline;
  }
  /* Floating labels follow the renamed data-filled / data-invalid attributes. */
  .demo-form[data-variant='floating'] .form-field :global(.field) {
    position: relative;
  }
  .demo-form[data-variant='floating'] .form-field :global(.field label) {
    position: absolute;
    top: 0.85rem;
    left: 0.9rem;
    font-weight: 400;
    color: var(--color-text-muted);
    pointer-events: none;
    transition:
      transform var(--duration-ui) var(--ease-ui),
      font-size var(--duration-ui) var(--ease-ui);
  }
  .demo-form[data-variant='floating'] .form-field :global(.field input) {
    padding-top: 1.35rem;
    padding-bottom: 0.4rem;
  }
  .demo-form[data-variant='floating'] .form-field :global(.field:has(:focus, [data-filled]) label) {
    transform: translateY(-0.65rem);
    font-size: 0.7rem;
  }
  .demo-form[data-variant='floating'] :global([data-invalid][data-filled]) {
    border-color: var(--color-danger);
  }
  .textarea {
    display: grid;
    gap: 0.375rem;
  }
  .textarea label,
  .guest label,
  .choices > legend {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  textarea,
  select[multiple],
  .guest input {
    box-sizing: border-box;
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-bg-soft);
    color: var(--color-text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    transition: border-color var(--duration-ui) var(--ease-ui);
  }
  select[multiple] {
    appearance: none;
    padding: 0.375rem;
    cursor: pointer;
  }
  select[multiple] option {
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
  }
  textarea {
    resize: vertical;
  }
  textarea:hover,
  select[multiple]:hover,
  .guest input:hover {
    border-color: var(--palette-border-hover, var(--color-accent));
  }
  textarea::placeholder {
    color: var(--color-text-subtle);
  }
  textarea:focus-visible,
  select[multiple]:focus-visible,
  .guest input:focus-visible,
  .choice input:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  .choices {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .choice-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .choice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg-soft);
    color: var(--color-text);
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color var(--duration-ui) var(--ease-ui);
  }
  .consent {
    justify-self: start;
    border-radius: var(--radius-control);
  }
  .choice:hover {
    border-color: var(--palette-border-hover, var(--color-accent));
  }
  .choice:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .choice input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .guests {
    display: grid;
    gap: 0.75rem;
  }
  .guest-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .guest-row input {
    flex: 1 1 12rem;
    width: auto;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
  .actions :global(.btn:disabled) {
    cursor: not-allowed;
    opacity: 0.55;
  }
  @media (prefers-reduced-motion: reduce) {
    textarea,
    select[multiple],
    .guest input,
    .choice,
    .demo-form[data-variant='floating'] .form-field :global(.field label) {
      transition: none;
    }
  }
</style>

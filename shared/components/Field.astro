---
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'input'> {
  label: string
  id: string
}
// Visible-label text input matching Select. TextField keeps its visually hidden
// label for compact search-style inputs; use Field inside demos and forms.
// `type` is destructured: spreading it after a literal type would duplicate the
// attribute and the browser keeps the first, so password fields showed text.
const { label, id, type = 'text', class: className, ...attributes } = Astro.props
---

<div data-ui class:list={['field', className]}>
  <label for={id}>{label}</label>
  <input {...attributes} type={type} id={id} />
</div>

<style>
  .field {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  input {
    box-sizing: border-box;
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.875rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-bg-soft);
    color: var(--color-text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    cursor: text;
    transition: border-color var(--duration-ui) var(--ease-ui);
  }
  input:hover {
    border-color: var(--palette-border-hover, var(--color-accent));
  }
  input::placeholder {
    color: var(--color-text-subtle);
  }
  input:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }
  input:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }
  @media (prefers-reduced-motion: reduce) {
    input {
      transition: none;
    }
  }
</style>

---
import CardGrid from '../../../shared/components/CardGrid.astro'
import { getI18n } from '../i18n/utils'
import Section from '../../../shared/components/Section.astro'
import Box from '../../../shared/components/Box.astro'
import SectionHeading from '../components/SectionHeading.astro'
import RichText from '../components/RichText.astro'
import FeatureCard from '../components/FeatureCard.astro'
const i18n = getI18n(Astro)
const t = i18n.sections.features
const headingId = `section-heading-${crypto.randomUUID()}`
---

<Section
  aria-labelledby={headingId}
  spacing="none"
  id="features"
  class:list={['content-section features-section']}
>
  <Box>
    <SectionHeading
      headingId={headingId}
      context="features"
      eyebrow={t.eyebrow}
      class:list={['mb-12 flex flex-col items-start gap-3']}
    >
      {t.title}
      <br />
      <span class:list={['serif italic']}>{t.titleAccent}</span>
    </SectionHeading>

    <CardGrid columns={3} class:list={['feature-grid']}>
      <FeatureCard title={t.items.dependencies.title} number="01">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="M7 9h10M7 13h6M7 17h4"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.dependencies.description} />
      </FeatureCard>
      <FeatureCard title={t.items.accessibility.title} number="02">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 8v5M12 16h.01"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.accessibility.description} />
      </FeatureCard>
      <FeatureCard title={t.items.lifecycle.title} number="03">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3v9"></path>
            <path d="M18.36 6.64a9 9 0 1 1-12.72 0"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.lifecycle.description} />
      </FeatureCard>
      <FeatureCard title={t.items.entrypoints.title} number="04">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m3 7 2 2 4-4M3 17l2 2 4-4M13 6h8M13 12h8M13 18h8"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.entrypoints.description} />
      </FeatureCard>
      <FeatureCard title={t.items.frameworks.title} number="05">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.frameworks.description} />
      </FeatureCard>
      <FeatureCard title={t.items.markup.title} number="06">
        <Fragment slot="icon">
          <svg
            aria-hidden="true"
            width="1.125rem"
            height="1.125rem"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
            <path d="M2 10h20M6 15h4"></path>
          </svg>
        </Fragment>
        <RichText parts={t.items.markup.description} />
      </FeatureCard>
    </CardGrid>
  </Box>
</Section>

<style>
  .feature-grid {
    gap: 0.75rem;
  }
  @media (width < 48rem) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width < 30rem) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
